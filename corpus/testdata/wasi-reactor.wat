;; SPDX-License-Identifier: MIT
;; Start -> _initialize -> input installation -> exported workload.
;; Calls real Preview 1 imports without inheriting ambient host inputs.
(module
  (import "wasi_snapshot_preview1" "args_sizes_get" (func $args (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "environ_sizes_get" (func $env (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "random_get" (func $random (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (global $state (mut i32) (i32.const 0))
  (global $calls (mut i32) (i32.const 0))
  (func $start (global.set $state (i32.const 1)))
  (start $start)
  (func (export "_initialize")
    (if (i32.ne (global.get $state) (i32.const 1)) (then unreachable))
    (if (call $args (i32.const 0) (i32.const 4)) (then unreachable))
    (if (call $env (i32.const 8) (i32.const 12)) (then unreachable))
    (if (i32.or (i32.or (i32.load (i32.const 0)) (i32.load (i32.const 4)))
                (i32.or (i32.load (i32.const 8)) (i32.load (i32.const 12)))) (then unreachable))
    (i32.store (i32.const 16) (i32.const -1))
    (if (call $random (i32.const 16) (i32.const 4)) (then unreachable))
    (if (i32.load (i32.const 16)) (then unreachable))
    (i32.store (i32.const 64) (i32.const 1))
    (global.set $state (i32.const 2)))
  (func (export "input_ptr") (result i32)
    (if (i32.ne (global.get $state) (i32.const 2)) (then unreachable))
    (i32.const 128))
  (func $benchmark (export "benchmark") (param $n i32) (result i32)
    (if (i32.ne (global.get $state) (i32.const 2)) (then unreachable))
    (i32.add (local.get $n) (i32.load (i32.const 128))))
  (func (export "once") (param $n i32) (result i32)
    (local $result i32)
    (local.set $result (call $benchmark (local.get $n)))
    (global.set $state (i32.const 3))
    (local.get $result))
  (func (export "write_output") (param $n i32) (result i32)
    (i32.store (i32.const 32) (i32.const 128))
    (i32.store (i32.const 36) (i32.const 4))
    (drop (call $write (i32.const 1) (i32.const 32) (i32.const 1) (i32.const 40)))
    (i32.const 42))
  (func (export "wrong_middle") (param i32) (result i32)
    (global.set $calls (i32.add (global.get $calls) (i32.const 1)))
    (if (result i32) (i32.eq (global.get $calls) (i32.const 2))
      (then (i32.const 99)) (else (i32.const 42))))
  (func (export "write_pointer") (result i32)
    (i32.store (i32.const 32) (i32.const 128))
    (i32.store (i32.const 36) (i32.const 4))
    (drop (call $write (i32.const 1) (i32.const 32) (i32.const 1) (i32.const 40)))
    (i32.const 64))
  (func (export "param_init_") (param i32))
  (func (export "result_init") (result i32) (i32.const 0))
)
